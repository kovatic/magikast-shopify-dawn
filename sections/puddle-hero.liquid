{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

{%- if section.settings.slide_height == 'adapt' and section.blocks.first.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #PuddleHero-{{ section.id }}::before,
      #PuddleHero-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
    @media screen and (min-width: 750px) {
      #PuddleHero-{{ section.id }}::before,
      #PuddleHero-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

<slideshow-component
  class="puddle-hero slider-mobile-gutter"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  <div
    id="Slider-{{ section.id }}"
    class="puddle-hero__track slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      {%- style -%}
        #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
          opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
        }
        #Slide-{{ section.id }}-{{ forloop.index }} .puddle-hero__content {
          --content-heading-color: {{ block.settings.heading_color }};
          --content-foreground-color: {{ block.settings.foreground_color }};
          --content-max-width: {{ block.settings.content_max_width }}px;
        }
      {%- endstyle -%}
      <div
        class="puddle-hero__slide slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        {%- comment -%} Background image {%- endcomment -%}
        <div class="puddle-hero__bg banner__media media slideshow__media{% if block.settings.image == blank %} placeholder{% endif %}">
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign img_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              assign fetch_priority = 'auto'
              if forloop.first
                assign fetch_priority = 'high'
              endif
            -%}
            {%- if forloop.first -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag:
                  width: block.settings.image.width,
                  height: img_height,
                  sizes: 'min(1300px, 100vw)',
                  widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                  fetchpriority: fetch_priority,
                  loading: 'eager'
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag:
                  width: block.settings.image.width,
                  height: img_height,
                  sizes: 'min(1300px, 100vw)',
                  widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                  loading: 'lazy'
              }}
            {%- endif -%}
          {%- else -%}
            {%- assign placeholder_index = forloop.index | modulo: 2 -%}
            {%- if placeholder_index == 1 -%}
              {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- comment -%} Overlay tint {%- endcomment -%}
        <div class="puddle-hero__overlay"></div>

        {%- comment -%} Text content — left-aligned overlay {%- endcomment -%}
        <div class="puddle-hero__content-wrap page-width{% if settings.animations_reveal_on_scroll and forloop.first %} scroll-trigger animate--slide-in{% endif %}">
          <div class="puddle-hero__content">
            {%- if block.settings.subheading != blank -%}
              <p class="puddle-hero__subheading">{{ block.settings.subheading | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <div class="puddle-hero__heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</div>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <div class="puddle-hero__description rte">{{ block.settings.description }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="puddle-hero__buttons">
                <a
                  {% if block.settings.link != blank %}
                    href="{{ block.settings.link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  aria-label="{{ block.settings.button_label | escape }}"
                  class="puddle-hero__btn button button--primary"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="puddle-hero__controls slider-buttons" aria-label="{{ 'sections.slideshow.carousel' | t }}">
      <div class="puddle-hero__counter">
        <span class="slider-counter--current">1</span>
        <span aria-hidden="true">/</span>
        <span class="slider-counter--total">{{ section.blocks.size }}</span>
      </div>
      <button
        type="button"
        class="puddle-hero__arrow puddle-hero__arrow--prev slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15.75 19.5-7.5-7.5 7.5-7.5"/>
        </svg>
      </button>
      <button
        type="button"
        class="puddle-hero__arrow puddle-hero__arrow--next slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
        </svg>
      </button>
    </div>
  {%- endif -%}
</slideshow-component>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% stylesheet %}
  /* ── Puddle Hero Slideshow ──────────────────────────────── */

  .puddle-hero {
    display: block;
    position: relative;
  }

  /* Inherit existing banner sizing classes; add border-radius */
  .puddle-hero__track {
    border-radius: var(--puddle-hero-radius, 16px);
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .puddle-hero__track {
      --puddle-hero-radius: 20px;
    }
  }

  /* Each slide */
  .puddle-hero__slide {
    position: relative;
  }

  /* Full-bleed background image */
  .puddle-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .puddle-hero__bg img,
  .puddle-hero__bg .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Overlay tint (uses ::after from banner CSS for opacity; this adds tint) */
  .puddle-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Content wrapper — positions content left-center on desktop */
  .puddle-hero__content-wrap {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: 5rem;
    padding-bottom: 7rem;
  }

  @media screen and (max-width: 749px) {
    .puddle-hero__content-wrap {
      align-items: flex-end;
      justify-content: center;
      text-align: center;
      padding-bottom: 8rem;
    }
  }

  /* Content box */
  .puddle-hero__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    max-width: var(--content-max-width, 460px);
  }

  @media screen and (max-width: 749px) {
    .puddle-hero__content {
      gap: 1.2rem;
      max-width: 100%;
    }
  }

  /* Subheading — small caps label above heading */
  .puddle-hero__subheading {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--content-foreground-color, currentColor);
    opacity: 0.85;
    overflow: hidden;
  }

  /* Main heading */
  .puddle-hero__heading {
    margin: 0;
    color: var(--content-heading-color, currentColor);
    line-height: 1.05;
  }

  /* Description */
  .puddle-hero__description {
    margin: 0;
    color: var(--content-foreground-color, currentColor);
    font-size: 1.5rem;
  }

  /* CTA button — pill style */
  .puddle-hero__btn.button {
    border-radius: 999px;
    padding: 1.2rem 2.8rem;
    font-size: 1.4rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
  }

  .puddle-hero__buttons {
    display: inline-flex;
    overflow: hidden;
  }

  /* Controls — bottom-right corner overlay */
  .puddle-hero__controls {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    padding: 0;
  }

  /* Override slider-buttons border from component-slider.css */
  .puddle-hero__controls.slider-buttons {
    border: none;
  }

  .puddle-hero__counter {
    font-size: 1.3rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.25);
    color: #fff;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* Arrow buttons */
  .puddle-hero__arrow {
    width: 3.8rem;
    height: 3.8rem;
    border-radius: 50%;
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 200ms ease, transform 150ms ease;
    padding: 0;
  }

  .puddle-hero__arrow svg {
    width: 1.8rem;
    height: 1.8rem;
    flex-shrink: 0;
  }

  /* Override slider-button default styles */
  .puddle-hero__arrow.slider-button {
    background: rgba(0, 0, 0, 0.25);
    color: #fff;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .puddle-hero__arrow.slider-button:hover {
    background: rgba(0, 0, 0, 0.5);
    transform: scale(1.05);
  }

  @media screen and (max-width: 749px) {
    .puddle-hero__controls {
      bottom: 1.5rem;
      right: 1.5rem;
    }

    .puddle-hero__arrow {
      width: 3.2rem;
      height: 3.2rem;
    }

    .puddle-hero__arrow svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Puddle hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "slide_height",
      "label": "Slide height",
      "options": [
        { "value": "adapt_image", "label": "Adapt to image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Accessibility label",
      "default": "Slideshow about our brand"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Image overlay opacity",
          "default": 0
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Holiday mode on"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Spring Collections"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" },
            { "value": "hxxl", "label": "Huge" }
          ],
          "default": "hxl"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>We make shopping easy.</p>"
        },
        {
          "type": "range",
          "id": "content_max_width",
          "label": "Content max width (px)",
          "min": 280,
          "max": 700,
          "step": 20,
          "default": 460
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#040fda"
        },
        {
          "type": "color",
          "id": "foreground_color",
          "label": "Text / subheading color",
          "default": "#040fda"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Puddle hero",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "subheading": "End of year sale",
            "heading": "40% Off Select Styles",
            "description": "<p>New beautiful summer clothes are now available online.</p>",
            "button_label": "Shop now",
            "heading_color": "#040fda",
            "foreground_color": "#040fda"
          }
        },
        {
          "type": "slide",
          "settings": {
            "subheading": "Holiday mode on",
            "heading": "Spring Collections",
            "description": "<p>We make shopping easy.</p>",
            "button_label": "Shop now",
            "heading_color": "#0255fe",
            "foreground_color": "#0255fe"
          }
        }
      ]
    }
  ]
}
{% endschema %}
